# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Use the TMDB API Read Access Token (Bearer token), not a browser key.
TMDB_TOKEN=your-tmdb-read-access-token

# Optional: only server-side maintenance routes/jobs should ever use this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

